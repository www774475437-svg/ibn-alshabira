rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'www774475437@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }
    function stepOk(field) {
      return request.resource.data.get(field, 0) is int &&
        request.resource.data.get(field, 0) - (resource == null ? 0 : resource.data.get(field, 0)) in [0, 1];
    }
    match /answers/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /titleEdits/{id} { allow read: if true; allow write: if isAdmin(); }
    match /series/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /scholars/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /config/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /admins/{email}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /views/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['count', 'helpful', 'notHelpful'])
        && stepOk('count') && stepOk('helpful') && stepOk('notHelpful');
      allow delete: if isAdmin();
    }
    match /searchMisses/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['count']) && stepOk('count');
      allow read, delete: if isAdmin();
    }
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['answerId', 'title', 'note', 'by', 'at'])
        && request.resource.data.note is string && request.resource.data.note.size() < 2000;
      allow read, delete: if isAdmin();
    }
    match /questions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'text', 'at', 'status', 'reply', 'published'])
        && request.resource.data.text is string && request.resource.data.text.size() < 3000
        && request.resource.data.status == 'new' && request.resource.data.reply == ''
        && request.resource.data.published == false;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}

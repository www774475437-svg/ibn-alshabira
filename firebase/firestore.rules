rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isDev() { return verified() && request.auth.token.email == 'www774475437@gmail.com'; }
    function staffPath() { return /databases/$(database)/documents/admins/$(request.auth.token.email); }
    function isAdmin() { return isDev() || (verified() && exists(staffPath())); }
    function isFullAdmin() {
      return isDev() || (verified() && exists(staffPath()) && get(staffPath()).data.get('role', 'admin') == 'admin');
    }
    function isOwner() {
      return isFullAdmin() && exists(staffPath()) && get(staffPath()).data.get('owner', false) == true;
    }
    function stepOk(field) {
      return request.resource.data.get(field, 0) is int &&
        request.resource.data.get(field, 0) - (resource == null ? 0 : resource.data.get(field, 0)) in [0, 1];
    }
    match /answers/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /titleEdits/{id} { allow read: if true; allow write: if isAdmin(); }
    match /series/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /scholars/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /drafts/{id}     { allow read, write: if isAdmin(); }
    match /config/{id}     { allow read: if true; allow write: if isFullAdmin(); }
    match /admins/{email}  {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      // Only the developer and the sheikh's own account manage the staff;
      // only the developer decides who that account is.
      allow create, update: if isDev() || (isOwner() && request.resource.data.get('owner', false) == false);
      allow delete: if isDev() || (isOwner() && resource.data.get('owner', false) == false);
    }
    match /blocked/{uid}   { allow read, write: if isAdmin(); }
    match /log/{id}        { allow create: if isAdmin(); allow read, delete: if isDev(); }
    match /views/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['count', 'helpful', 'notHelpful'])
        && stepOk('count') && stepOk('helpful') && stepOk('notHelpful');
      allow delete: if isAdmin();
    }
    match /searchMisses/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['count']) && stepOk('count');
      allow read, delete: if isAdmin();
    }
    match /searches/{week} {
      allow read: if true;
      allow create, update: if request.resource.data.size() <= 5000;
    }
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['answerId', 'title', 'note', 'by', 'at'])
        && request.resource.data.note is string && request.resource.data.note.size() < 2000;
      allow read, delete: if isAdmin();
    }
    match /questions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/blocked/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['uid', 'text', 'chapter', 'name', 'at', 'status', 'reply', 'published'])
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() < 60
        && request.resource.data.text is string && request.resource.data.text.size() < 3000
        && request.resource.data.status == 'new' && request.resource.data.reply == ''
        && request.resource.data.published == false;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}

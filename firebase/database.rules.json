{
  "rules": {
    "ch": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && data.parent().parent().exists()"
          }
        },
        "rematch": {
          ".write": "auth != null && data.parent().exists()"
        },
        "rematchBy": {
          ".write": "auth != null && data.parent().exists()"
        }
      }
    },
    "inv": {
      "$no": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').isString() && newData.child('by').val().length < 60"
        }
      }
    },
    "tour": {
      "$day": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === '3oqvJwPEiXSohYH7GnqwCH1E7HY2'",
        "p": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.hasChildren(['name', 'score']) && newData.child('name').isString() && newData.child('name').val().length < 80"
          }
        }
      }
    }
  }
}